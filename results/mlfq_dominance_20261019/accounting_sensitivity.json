  "findings": {
    "frozen_switch_costs": "Only Priority RR charges one tick; other eligible policies charge zero. This matches the frozen contract and is a modeling asymmetry, not an implementation mismatch.",
    "normalization": "No degenerate historical-six metric spans occur on the original1000 default workloads. Eligible-only bounds change two winners; default MLFQ raw advantages over RR remain.",
    "equal_cost_1_caveat": "Nonzero-cost MLFQ selects a ready item before overhead and releases events during overhead without reselecting before service. A stale aging deadline can then force a zero-service dispatch, followed by preemption, last_pid update, and another switch charge. In seed2026000013 at639, the chosen cpu_intensive_6 is level1, cpu_intensive_8 has just returned at level0, and cpu_intensive_5 has an aging deadline639. This is outside frozen MLFQ cost0; equalcost1 results are sensitivity outputs of this implementation, not an independently validated alternative policy.",
    "feature_aging_repro": {
      "processes": "A(arrival0,cpu3); P1..P21(arrival1..21,cpu1); P23(arrival23,cpu1)",
      "state": "Dispatch MLFQ until current_time23. A last served[0,2], remained ready continuously since2, promoted at22.",
      "expected_continuous_ready_wait": 21,
      "reported_ready_wait_max": 1,
      "cause": "_age_mlfq resets _Ready.time for aging; extractor uses the same timestamp for ready waiting. Completion-based static waiting metrics are unaffected."
    }
